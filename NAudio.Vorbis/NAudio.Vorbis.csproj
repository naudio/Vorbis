<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>NAudio.Vorbis</RootNamespace>
    <Description>NAudio support for Vorbis</Description>
    <PackageTags>audio c# .NET sound vorbis NAudio NVorbis</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.0.1" />
    <PackageReference Include="NVorbis" Version="$(NVorbisVersion)" />
  </ItemGroup>

</Project>
